# ========================================================
# FULL-STACK IAM SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env and adjust variables for your target deployment environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.

# Application Profile & Server Port
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Database (PostgreSQL)
POSTGRES_DB=iam_db
POSTGRES_USER=iam_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/iam_db
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Redis Caching & Session Store
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_TIMEOUT=2000ms

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Session & Token Timeouts
SESSION_INACTIVITY_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=86400

# Multi-Factor Authentication (MFA / TOTP)
MFA_ISSUER=IAM Server
MFA_ENCRYPTION_KEY=change-me-32-byte-aes-key-for-mfa-encryption!
MFA_CHALLENGE_TIMEOUT=300
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_SECONDS=900
MFA_WINDOW_SIZE=1

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=20
RATE_LIMIT_MFA=15
RATE_LIMIT_TOKEN=60
RATE_LIMIT_ADMIN=120
RATE_LIMIT_WINDOW_SECONDS=60

# JWT / RSA Persistent Signing Keys (Optional - ephemeral 2048-bit key generated if empty)
# Format: Base64 or standard PEM string without newline escapes in single line
JWT_RSA_KEY_ID=iam-jwt-key-2026
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=

# OAuth 2.0 Client Default Credentials (for external clients)
OAUTH_CLIENT_ID=iam-client
OAUTH_CLIENT_SECRET=change-me-oauth-client-secret
